# Copy to .env on EC2, generate a unique APP_KEY, and replace every value in <>.
APP_NAME="Lily Inventory API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.duckdns.org

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# MariaDB/MySQL must listen only on 127.0.0.1. Never expose port 3306 publicly.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_db
DB_USERNAME=inventory_app
DB_PASSWORD=<use-a-long-unique-password>

# These tables are created by the existing migrations.
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public
MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Lily"
REQUEST_ACCESS_RECIPIENT=<recipient-email>

# Comma-separated exact browser origins. Add your custom Vercel domain too,
# if you later attach one. Do not use * with an authenticated API.
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
# Optional only for preview deployments. Keep this limited to your Vercel team.
# CORS_ALLOWED_ORIGIN_PATTERNS=#^https://your-project-[a-z0-9-]+\\.vercel\\.app$#

# Keep browser token lifetime aligned with the Nuxt client cookie.
SANCTUM_EXPIRATION=1440
SUPER_ADMIN_EMAIL=<initial-admin-email>
SUPER_ADMIN_PASSWORD=<long-unique-initial-password>
